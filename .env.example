# Server-side variables. Use secure hosting configuration; do not commit real values.
SUPABASE_PROJ_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUB_KEY=YOUR_PUBLISHABLE_KEY
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
# Shared ONLY between Next.js server and the Supabase Edge Function, at least 32 random bytes.
# Also used to hash spin-game IP addresses. Keep stable to preserve the one-attempt-per-IP limit.
QUESTION_PROXY_SECRET=YOUR_RANDOM_PROXY_SECRET
# Header overwritten by your trusted hosting ingress, used by questions and the spin game.
# On Vercel use x-vercel-forwarded-for. See docs/audience-questions.md.
QUESTION_TRUSTED_IP_HEADER=YOUR_HOSTING_TRUSTED_IP_HEADER
# Required server-side for spin-game awards and one-time admin provisioning. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Required only during first-time admin creation; use a password manager-generated password.
ADMIN_SETUP_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
